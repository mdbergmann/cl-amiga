;;; Library base  opened at load time on AmigaOS/MorphOS; NIL on other
;;; hosts (the module still loads there for testing and compilation).
(defvar *exec-base*
  (when (member :amigaos *features*)
    (amiga.ffi:open-library-or-die "exec.library" 0)))
(defvar *exec-version*
  (and *exec-base* (amiga.ffi:library-version *exec-base*)))
(defun %version>= (n)
  (and *exec-version* (>= *exec-version* n)))


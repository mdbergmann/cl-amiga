(in-package "AMIGA.RAW.GRAPHICS")

;;; Library base  opened at load time on AmigaOS/MorphOS; NIL on other
;;; hosts (the module still loads there for testing and compilation).
(defvar *graphics-base*
  (when (member :amigaos *features*)
    (amiga.ffi:open-library-or-die "graphics.library" 0)))
(defvar *graphics-version*
  (and *graphics-base* (amiga.ffi:library-version *graphics-base*)))
(defun %version>= (n)
  (and *graphics-version* (>= *graphics-version* n)))


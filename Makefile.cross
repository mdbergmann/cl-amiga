# CL-Amiga Cross-compilation Makefile
# Uses m68k-amigaos-gcc from tools/m68k-amigaos-gcc/prefix
# Run: make -f Makefile.cross [amiga|test-amiga|clean]
#      make -f Makefile.cross amiga FPU=1   (hard-float variant, see below)
#      make -f Makefile.cross amiga WIDE=1  (wide-string variant, see below)

TOOLCHAIN = $(CURDIR)/tools/m68k-amigaos-gcc/prefix
CC        = $(TOOLCHAIN)/bin/m68k-amigaos-gcc
# NOTE: m68k-amigaos-gcc -O2 miscompiles flexible-array pointer access
# (`obj->data` passed as a function argument silently drops the first byte).
# We work around it with `volatile` locals at the affected call sites
# (search for "m68k workaround").  -flto and -O1 each have their own
# regressions on this toolchain — neither is a clean substitute.
#
# -Os passes the full tests/amiga/run-tests.lisp suite on real Amiga
# and produces a ~175 KB smaller binary than -O2, so we use it.
# The volatile workaround above still applies.
# NOTE: -ffunction-sections + -Wl,--gc-sections was tried (2026-05-21) and is a
# NET LOSS on the AmigaOS hunk format: the linker does remove dead sections, but
# per-function alignment padding + per-section hunk-table overhead (hundreds of
# tiny sections) outweighs it — binary grew +35 KB / +6 %. See specs/modularize.md.
# FPU=1 builds the hard-float variant: -m68881 compiles double arithmetic to
# inline FPU instructions (libm from the toolchain's libm020/libm881 multilib)
# instead of soft-float calls through mathieeedoubbas.library.  Runs on any
# machine with an FPU — 68881/68882 cards, 68040/68060 (the 68040/68060.library
# math emulation covers the transcendental instructions), Vampire/PiStorm.
# The binary REQUIRES an FPU: on a plain 68020/68030 it dies with a line-F
# exception, so never point test-amiga-lowend (FPU-less 68020 config) at it.
# Each variant gets its own object dir so the two never mix.
FPU ?= 0
ifeq ($(FPU),1)
FLOATFLAGS = -m68881
BUILDDIR   = build/cross-fpu
else
FLOATFLAGS = -msoft-float
BUILDDIR   = build/cross
endif

# WIDE=1 builds the wide-string variant: CL_WIDE_STRINGS raises
# CHAR-CODE-LIMIT above 65533 (full Unicode in the Lisp heap; the
# representation stays adaptive — 8-bit TYPE_STRING remains the default and
# UTF-32 TYPE_WIDE_STRING is used only for strings actually containing
# chars > 255, so pure-ASCII workloads cost the same as the narrow build).
# The OS never sees wide chars — everything crossing the OS boundary is
# encoded to bytes — but libraries like flexi-streams/drakma hard-require
# the raised CHAR-CODE-LIMIT (their external-format tables call
# (code-char >255) at load time), so this is the knob for running them on
# big-RAM 68k machines (Vampire/PiStorm).  Default is narrow (8-bit): the
# release binaries stay narrow to keep the 68020/8MB primary target lean.
# Composes with FPU=1 (verified on a Vampire V4, 2026-08-15: WIDE=1 FPU=1
# runs drakma with HTTP and AmiSSL HTTPS green); every FPU/WIDE combination
# gets its own object dir so variants never mix.  FASL note: wide-build
# FASLs stay readable by narrow builds unless a literal actually contains
# non-ASCII text (the writer downgrades all-ASCII strings to the narrow
# tag; genuinely wide literals use FASL_TAG_WIDE_STRING, which narrow
# builds reject cleanly).
WIDE ?= 0
ifeq ($(WIDE),1)
WIDEFLAGS = -DCL_WIDE_STRINGS
BUILDDIR := $(BUILDDIR)-wide
else
WIDEFLAGS =
endif

CFLAGS    = -noixemul -mcpu=68020 $(FLOATFLAGS) $(WIDEFLAGS) -std=c99 -Wall -Os -fno-tree-switch-conversion -DPLATFORM_AMIGA -DJIT_M68K $(DEBUG_FLAGS)
LDFLAGS   = -noixemul -mcpu=68020 $(FLOATFLAGS) -fno-tree-switch-conversion

# AmiSSL SDK headers (vendored in include/amissl-sdk — see its README.md):
# give the build TLS (EXT:SOCKET-START-TLS) through amisslmaster.library,
# opened lazily at runtime by the socket reactor.  The gcc path calls
# AmiSSL through the SDK's inline headers (register-mapped calls via
# AmiSSLBase), so no link library is needed; a machine without AmiSSL
# installed still runs — TLS just reports unavailable.  The wildcard guard
# keeps the build working even with the headers removed.
AMISSL_INC ?= $(CURDIR)/include/amissl-sdk
ifneq ($(wildcard $(AMISSL_INC)/proto/amissl.h),)
CFLAGS += -DCL_HAVE_AMISSL -I$(AMISSL_INC)
endif

SRCDIR   = src

# Source files
PLATFORM_SRC = $(SRCDIR)/platform/platform_amiga.c \
               $(SRCDIR)/platform/platform_amiga_rexx.c \
               $(SRCDIR)/platform/platform_thread_amiga.c
PLATFORM_ASM = $(SRCDIR)/platform/ffi_dispatch_m68k.s
CORE_SRC     = $(SRCDIR)/core/types.c \
               $(SRCDIR)/core/mem.c \
               $(SRCDIR)/core/error.c \
               $(SRCDIR)/core/symbol.c \
               $(SRCDIR)/core/package.c \
               $(SRCDIR)/core/reader.c \
               $(SRCDIR)/core/readtable.c \
               $(SRCDIR)/core/printer.c \
               $(SRCDIR)/core/env.c \
               $(SRCDIR)/core/compiler.c \
               $(SRCDIR)/core/compiler_special.c \
               $(SRCDIR)/core/compiler_extra.c \
               $(SRCDIR)/core/peephole.c \
               $(SRCDIR)/core/vm.c \
               $(SRCDIR)/core/builtins.c \
               $(SRCDIR)/core/builtins_arith.c \
               $(SRCDIR)/core/builtins_io.c \
               $(SRCDIR)/core/builtins_format.c \
               $(SRCDIR)/core/builtins_mutation.c \
               $(SRCDIR)/core/builtins_strings.c \
               $(SRCDIR)/core/builtins_lists.c \
               $(SRCDIR)/core/builtins_hashtable.c \
               $(SRCDIR)/core/builtins_sequence.c \
               $(SRCDIR)/core/builtins_sequence2.c \
               $(SRCDIR)/core/builtins_type.c \
               $(SRCDIR)/core/builtins_condition.c \
               $(SRCDIR)/core/builtins_package.c \
               $(SRCDIR)/core/builtins_struct.c \
               $(SRCDIR)/core/builtins_array.c \
               $(SRCDIR)/core/builtins_stream.c \
               $(SRCDIR)/core/builtins_random.c \
               $(SRCDIR)/core/builtins_bitvector.c \
               $(SRCDIR)/core/builtins_pathname.c \
               $(SRCDIR)/core/builtins_describe.c \
               $(SRCDIR)/core/builtins_inspect.c \
               $(SRCDIR)/core/builtins_thread.c \
               $(SRCDIR)/core/builtins_ffi.c \
               $(SRCDIR)/core/builtins_amiga.c \
               $(SRCDIR)/core/stream.c \
               $(SRCDIR)/core/bignum.c \
               $(SRCDIR)/core/ratio.c \
               $(SRCDIR)/core/float.c \
               $(SRCDIR)/core/float_dtoa.c \
               $(SRCDIR)/core/float_math.c \
               $(SRCDIR)/core/debugger.c \
               $(SRCDIR)/core/repl.c \
               $(SRCDIR)/core/fasl.c \
               $(SRCDIR)/core/color.c \
               $(SRCDIR)/core/thread.c \
               $(SRCDIR)/core/string_utils.c
JIT_SRC      = $(SRCDIR)/jit/codebuf.c \
               $(SRCDIR)/jit/jit.c \
               $(SRCDIR)/jit/codegen_m68k.c \
               $(SRCDIR)/jit/asm_m68k.c \
               $(SRCDIR)/jit/runtime.c
MAIN_SRC     = $(SRCDIR)/main.c

ALL_SRCS = $(MAIN_SRC) $(PLATFORM_SRC) $(CORE_SRC) $(JIT_SRC)
ALL_OBJS = $(patsubst $(SRCDIR)/%.c,$(BUILDDIR)/%.o,$(ALL_SRCS)) \
           $(patsubst $(SRCDIR)/%.s,$(BUILDDIR)/%.o,$(PLATFORM_ASM))

.PHONY: amiga test-amiga test-amiga-lowend clean check-toolchain

amiga: check-toolchain $(BUILDDIR)/clamiga

check-toolchain:
	@if [ ! -x "$(CC)" ]; then \
		echo ""; \
		echo "  m68k-amigaos-gcc not found at:"; \
		echo "    $(CC)"; \
		echo ""; \
		echo "  Install it with:"; \
		echo "    ./tools/setup-toolchain.sh"; \
		echo ""; \
		echo "  (downloads a prebuilt toolchain on macOS arm64,"; \
		echo "   builds from source elsewhere — pass --build to force)"; \
		echo ""; \
		exit 1; \
	fi

$(BUILDDIR)/clamiga: $(ALL_OBJS)
	@mkdir -p $(dir $@)
	$(CC) $(LDFLAGS) -o $@ $^ -lm
	@mkdir -p build/amiga
	cp $(BUILDDIR)/clamiga build/amiga/clamiga

$(BUILDDIR)/%.o: $(SRCDIR)/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -I$(SRCDIR) -MMD -MP -c -o $@ $<

$(BUILDDIR)/%.o: $(SRCDIR)/%.s
	@mkdir -p $(dir $@)
	$(CC) -mcpu=68020 -c -o $@ $<

# Auto-generated header dependency files (-MMD -MP).  Without this,
# changing a header (e.g. CL_Thread or CL_ErrorFrame layout in
# error.h / thread.h) leaves dependent .o files stale and produces
# silently mismatched ABIs — a regression mode that previously cost
# real debug time on this codebase.  Mirrors what the host Makefile
# does via the same mechanism.
-include $(ALL_OBJS:.o=.d)

# Cross-compile, place binary, launch FS-UAE for testing.
# Default: high-end JIT config (A4000/68040/Picasso96) — faster turnaround
# for everyday verification.  Use `test-amiga-lowend` to run against the
# documented 68020 baseline (A1200/68020/16 MB, cycle-accurate, no JIT).
#
# run-fs-uae.sh supervises the emulator so the run is fully unattended:
# `C:UAEquit` (appended to call-on-ustartup) quits FS-UAE when the suite
# finishes, and the script's watchdog kills it if clamiga hangs.  No manual
# window-closing required.
# The explicit cp (also done on relink) matters when switching FPU= variants:
# without it an up-to-date $(BUILDDIR)/clamiga skips the link rule and FS-UAE
# would silently test whichever variant was deployed last.
test-amiga: $(BUILDDIR)/clamiga
	@mkdir -p build/amiga
	cp $(BUILDDIR)/clamiga build/amiga/clamiga
	@echo "=== Launching FS-UAE (high-end JIT config) — auto-quits when tests finish ==="
	verify/realamiga/run-fs-uae.sh verify/realamiga/verify.fs-uae
	@$(MAKE) --no-print-directory -f Makefile.cross verify-amiga

test-amiga-lowend: $(BUILDDIR)/clamiga
	@if [ "$(FPU)" = "1" ]; then \
		echo "ERROR: test-amiga-lowend runs an FPU-less 68020 config — the FPU=1 binary cannot run there."; \
		exit 1; \
	fi
	@mkdir -p build/amiga
	cp $(BUILDDIR)/clamiga build/amiga/clamiga
	@echo "=== Launching FS-UAE (lower-end 68020 baseline) — auto-quits when tests finish ==="
	verify/realamiga/run-fs-uae.sh verify/realamiga/verify-lowend.fs-uae
	@$(MAKE) --no-print-directory -f Makefile.cross verify-amiga

verify-amiga:
	@if [ ! -f build/amiga/test-results.log ]; then \
		echo "No test results found. Run FS-UAE first."; \
		exit 1; \
	fi
	@echo "=== Amiga Test Results ==="
	@cat build/amiga/test-results.log
	@if ! grep -q "ALL TESTS PASSED" build/amiga/test-results.log; then \
		echo "=== Amiga verification FAILED (tests) ==="; \
		exit 1; \
	fi
	@# The driver (call-on-ustartup) writes "=== run end ===" only after
	@# clamiga returns from main.  Its absence means clamiga hung at exit
	@# (e.g. the socket-reactor shutdown deadlock) and FS-UAE was stall-killed
	@# by the watchdog — the suite still "passed" but the binary never exited
	@# cleanly.  Require the marker so that regression fails loudly + fast.
	@if ! grep -q "=== run end ===" build/amiga/test-results.log; then \
		echo "=== Amiga verification FAILED (clamiga did not exit cleanly — shutdown hang?) ==="; \
		exit 1; \
	fi
	@echo "=== Amiga verification PASSED ==="

clean:
	rm -rf build/cross build/cross-fpu build/cross-wide build/cross-fpu-wide
